# Copy to .env and fill in. .env is gitignored.
TZ=America/New_York

# Grafana initial admin (change on first login)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# Discord alerting: Alertmanager reads the webhook URL from a gitignored file,
# NOT from this env. Create it once (see runbook 04):
#   echo 'https://discord.com/api/webhooks/xxxx/yyyy' > ../alertmanager/discord.secret
# The compose file mounts that file into the alertmanager container.
