# Copy to .env and fill in. .env is gitignored.
TZ=America/New_York

# Grafana initial admin (change on first login)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me

# Discord webhook for Alertmanager (via the alertmanager-discord bridge, see runbook 04)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
